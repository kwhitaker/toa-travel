{
  "name": "tomb-of-annihilation-travelogue",
  "description": "Generates travel days for the Tomb of Annihilation campaign, with some additional rules from Kyle Maxwell (https://skaldforge.wordpress.com/2017/10/02/tomb-of-annihilation-hex-crawl-procedure/)",
  "version": "0.0.130",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "dependencies": {
    "preact": "^10.29.8",
    "preact-feather": "^4.3.0",
    "seedrandom": "3.0.5",
    "tachyons": "4.12.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/seedrandom": "^3.0.8",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.2",
    "prettier": "3.9.9",
    "sass": "^1.105.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm test && npm run build"
  }
}
